{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carmediahub.org/schema/plugin-manifest/v0",
  "title": "CarMediaHub Plugin Manifest v0",
  "description": "Machine-readable contract matching @carmediahub/sdk validateManifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "sdk", "name", "description", "category", "runtime", "capabilities", "routes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "sdk": { "type": "string", "pattern": "^(?:\\^|~)?\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "name": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "category": { "enum": ["core-companion", "official", "adapter", "browser-bridge", "community"] },
    "runtime": { "enum": ["shared-adapter-host", "isolated-worker", "wasm-module"] },
    "migrationStatus": { "type": "string", "minLength": 1 },
    "upstreamSource": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["config", "secrets", "db", "storage", "media", "media-source", "history", "catalog", "display", "jobs", "events", "diagnostics", "gateway", "network", "browser", "transfer"] }
    },
    "serviceBindings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" } },
    "components": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/componentDependency" } },
    "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "worker": { "$ref": "#/$defs/entry" },
    "runtimeEntry": { "$ref": "#/$defs/entry" },
    "ui": {
      "type": "object", "additionalProperties": false, "required": ["entry", "vehicleSupported"],
      "properties": { "entry": { "type": "string", "pattern": "^\\./(?!.*\\.\\.)[A-Za-z0-9_./-]+$" }, "vehicleSupported": { "type": "boolean" } }
    }
  },
  "allOf": [
    { "if": { "properties": { "runtime": { "const": "isolated-worker" } } }, "then": { "required": ["worker"], "properties": { "worker": { "$ref": "#/$defs/entry" } } } },
    { "if": { "properties": { "runtime": { "const": "shared-adapter-host" } } }, "then": { "required": ["runtimeEntry"], "properties": { "category": { "const": "core-companion" }, "capabilities": { "type": "array", "items": { "enum": ["config", "display", "diagnostics", "events", "gateway"] } }, "runtimeEntry": { "$ref": "#/$defs/entry" } } } },
    { "if": { "properties": { "runtime": { "const": "wasm-module" } } }, "then": { "required": ["runtimeEntry"], "properties": { "runtimeEntry": { "$ref": "#/$defs/entry" } } } },
    { "if": { "required": ["serviceBindings"], "properties": { "serviceBindings": {} } }, "then": { "required": ["capabilities"], "properties": { "capabilities": { "type": "array", "contains": { "const": "network" } } } } }
  ],
  "$defs": {
    "localized": {
      "type": "object", "additionalProperties": false, "required": ["en", "zh-CN", "ko"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "zh-CN": { "type": "string", "minLength": 1 }, "ko": { "type": "string", "minLength": 1 } }
    },
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["entry", "protocol"],
      "properties": { "entry": { "type": "string", "pattern": "^\\./(?!.*\\.\\.)[A-Za-z0-9_./-]+$" }, "protocol": { "const": "0.1" } }
    },
    "route": {
      "type": "object", "additionalProperties": false, "required": ["path", "methods"],
      "properties": {
        "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_-]*$" },
        "methods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "PROPFIND"] } }
      }
    },
    "componentDependency": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["storage-service", "webdav", "media-processing", "archive", "network-egress", "browser-engine"] } },
        "optional": { "type": "boolean" }
      }
    }
  }
}
