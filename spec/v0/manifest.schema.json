{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carmediahub.org/schema/plugin-manifest/v0",
  "title": "CarMediaHub Plugin Manifest v0",
  "description": "Draft public contract for a CarMediaHub plugin package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "sdk",
    "publisher",
    "runtime",
    "capabilities",
    "resources",
    "dataLifecycle"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["range"],
      "properties": {
        "range": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumGroup", "entry"],
      "properties": {
        "minimumGroup": {
          "enum": ["wasm-module", "shared-adapter-host", "isolated-worker"]
        },
        "entry": { "type": "string", "pattern": "^(worker|wasm)/[A-Za-z0-9._/-]+$", "maxLength": 256 }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "navigation"],
      "properties": {
        "entry": { "type": "string", "pattern": "^ui/[A-Za-z0-9._/-]+$", "maxLength": 256 },
        "navigation": { "enum": ["app", "settings", "none"] }
      }
    },
    "routes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "access"],
        "properties": {
          "path": { "type": "string", "pattern": "^/apps/[a-z0-9][a-z0-9-]*/$", "maxLength": 128 },
          "access": { "enum": ["authenticated", "administrator"] }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": { "enum": ["private"] },
        "storage": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "mode"],
            "properties": {
              "kind": { "enum": ["plugin-data", "media-library"] },
              "mode": { "enum": ["read", "read-write"] }
            }
          }
        },
        "media": { "type": "array", "uniqueItems": true, "items": { "enum": ["probe", "remux", "transcode"] } },
        "display": { "type": "array", "uniqueItems": true, "items": { "enum": ["fullscreen"] } },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowHosts"],
          "properties": {
            "allowHosts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 253 }
            }
          }
        },
        "browser": { "enum": ["named-profile"] },
        "transfer": { "enum": ["managed"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memoryMiB", "network"],
      "properties": {
        "cpu": { "enum": ["low", "medium", "high"] },
        "memoryMiB": { "type": "integer", "minimum": 32, "maximum": 4096 },
        "network": { "enum": ["none", "bounded", "streaming"] }
      }
    },
    "dataLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export", "delete"],
      "properties": {
        "export": { "type": "boolean" },
        "delete": { "enum": ["user-confirmed", "administrator-confirmed"] }
      }
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 128 },
    "category": { "enum": ["core-companion", "official", "adapter", "browser-bridge", "community"] }
  }
}
